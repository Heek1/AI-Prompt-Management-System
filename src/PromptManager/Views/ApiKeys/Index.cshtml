@using PromptManager.Infrastructure
@using PromptManager.Api
@model List<ApiKeyInfo>
@{
    ViewData["Title"] = "API keys";
    var newKey = ViewData["NewKey"] as string;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

<header class="pm-head">
    <div>
        <h1>@T["API keys"]</h1>
        <p class="pm-sub">
            @T["Applications use a key to fetch the production version of a prompt from"] <code>@baseUrl/api/prompts/{slug}</code>@T[". The API is described at"] <a href="/openapi/v1.json"><code>/openapi/v1.json</code></a>.
            @T["Each key may make {0} requests per minute.", PromptApi.RequestsPerMinute]
        </p>
    </div>
</header>

@if (newKey is not null)
{
    <div class="alert alert-success" role="alert">
        <strong>@T["Your new key."]</strong> @T["Copy it now: it is not stored and cannot be shown again."]
        <div class="d-flex gap-2 mt-2">
            <code id="new-key" class="pm-key flex-fill" data-testid="new-key">@newKey</code>
            <button type="button" class="btn btn-outline-success btn-sm" data-copy-target="#new-key">@T["Copy"]</button>
        </div>
        <pre class="pm-key mt-3 mb-0">curl -H "X-Api-Key: @newKey" @baseUrl/api/prompts/&lt;slug&gt;</pre>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="key-name">@T["Name"]</label>
                <input id="key-name" name="name" class="form-control" maxlength="100" required placeholder="@T["e.g. support-bot production"]" />
            </div>
            <div class="col-md-4 d-grid">
                <button type="submit" class="btn btn-marker">@T["Create key"]</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-4 mb-0">@T["No keys yet. Create one for each application, so you can revoke it alone."]</p>
        }
        else
        {
            <table class="table align-middle mb-0 pm-table">
                <thead><tr><th>@T["Name"]</th><th>@T["Key"]</th><th>@T["Created"]</th><th>@T["Last used"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var k in Model)
                    {
                        <tr class="@(k.IsActive ? "" : "text-muted")">
                            <td>@k.Name</td>
                            <td><code>@k.Prefix…</code></td>
                            <td class="small">@k.CreatedAt.Date("dd MMM yyyy")</td>
                            <td class="small">@(k.LastUsedAt?.Date("dd MMM yyyy HH:mm") ?? T["never"].Value)</td>
                            <td class="text-end">
                                @if (k.IsActive)
                                {
                                    <form asp-action="Revoke" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@k.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="@T["Revoke this key? Applications using it will stop working."]">@T["Revoke"]</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="pm-status pm-status-draft">@T["revoked"]</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
