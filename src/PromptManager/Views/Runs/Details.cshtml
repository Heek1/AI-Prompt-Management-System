@using System.Globalization
@using PromptManager.DTOs
@using PromptManager.Infrastructure
@using PromptManager.Models
@model RunDetailsDto
@{
    ViewData["Title"] = T["Run #{0}", Model.Id].Value;
    var inv = CultureInfo.InvariantCulture;
}

<nav class="pm-crumbs" aria-label="@T["Breadcrumb"]">
    <a asp-controller="Prompts" asp-action="Index">@T["Library"]</a><span aria-hidden="true">/</span>
    <a asp-controller="Prompts" asp-action="Details" asp-route-id="@Model.PromptId">@Model.PromptTitle</a><span aria-hidden="true">/</span>
    <a asp-action="Index" asp-route-promptId="@Model.PromptId">@T["Runs"]</a><span aria-hidden="true">/</span>
    <span>#@Model.Id</span>
</nav>

<header class="pm-head">
    <div>
        <h1>@T["Run #{0}", Model.Id]</h1>
        <p class="pm-sub">@T["v{0} of {1} on", Model.VersionNumber, Model.PromptTitle] <code>@Model.Model</code>, @T["by {0}", Model.RunBy].</p>
    </div>
    <div class="pm-actions"><partial name="_RunStatusBadge" model="Model.Status" /></div>
</header>

<div class="row g-4">
    <div class="col-xl-8">
        @if (Model.Status == PromptRunStatus.Failed)
        {
            <div class="alert alert-danger">@T.Message(Model.Error)</div>
        }
        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <div class="alert alert-secondary">@Model.Note</div>
        }
        @if (Model.Status == PromptRunStatus.Truncated)
        {
            <div class="alert alert-warning">@T["The answer stopped at the token limit and is incomplete."]</div>
        }

        <section class="pm-sheet mb-4" aria-label="@T["Output"]">
            <div class="pm-sheet-head"><span class="pm-sheet-title">@T["Answer"]</span></div>
            @if (string.IsNullOrEmpty(Model.Output))
            {
                <p class="text-muted m-0 p-4">@T["No output."]</p>
            }
            else
            {
                <pre class="pm-output" data-testid="run-output">@Model.Output</pre>
            }
        </section>

        @if (Model.Variables.Any())
        {
            <h2 class="pm-section-title">@T["Values"]</h2>
            <dl class="pm-values">
                @foreach (var (name, value) in Model.Variables)
                {
                    <dt><span class="pm-var">{{@name}}</span></dt>
                    <dd>@value</dd>
                }
            </dl>
        }

        <h2 class="pm-section-title">@T["Text sent"]</h2>
        <section class="pm-sheet" aria-label="@T["Prompt sent"]">
            <div class="pm-sheet-head"><span class="pm-sheet-title">@T["v{0}, values filled in", Model.VersionNumber]</span></div>
            <pre class="pm-lines pm-lines-plain">@PromptMarkup.Lines(Model.PromptText)</pre>
        </section>
    </div>

    <aside class="col-xl-4">
        <section class="card">
            <div class="card-body">
                <div class="pm-stat-label">@T["Cost"]</div>
                <div class="pm-figure mb-3">$@Model.CostUsd.ToString("0.000000", inv)</div>
                <dl class="pm-facts">
                    <dt>@T["Status"]</dt><dd>@T[Model.Status.ToString()]</dd>
                    <dt>@T["Model"]</dt><dd><code>@Model.Model</code></dd>
                    @if (Model.ServedByModel is not null)
                    {
                        <dt>@T["Answered by"]</dt><dd><code>@Model.ServedByModel</code> @T["(fallback)"]</dd>
                    }
                    <dt>@T["Input tokens"]</dt><dd class="pm-num">@Model.InputTokens.ToString("N0")</dd>
                    <dt>@T["Output tokens"]</dt><dd class="pm-num">@Model.OutputTokens.ToString("N0")</dd>
                    <dt>@T["Duration"]</dt><dd class="pm-num">@((Model.DurationMs / 1000.0).ToString("0.00", inv)) s</dd>
                    <dt>@T["Stop reason"]</dt><dd>@(Model.StopReason ?? T["none"].Value)</dd>
                    <dt>@T["Run by"]</dt><dd>@Model.RunBy</dd>
                    <dt>@T["At"]</dt><dd class="pm-num">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss", inv) UTC</dd>
                </dl>
            </div>
        </section>
    </aside>
</div>
