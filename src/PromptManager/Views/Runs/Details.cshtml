@using System.Globalization
@using PromptManager.DTOs
@using PromptManager.Infrastructure
@using PromptManager.Models
@model RunDetailsDto
@{
    ViewData["Title"] = $"Run #{Model.Id}";
    var inv = CultureInfo.InvariantCulture;
}

<nav class="pm-crumbs" aria-label="Breadcrumb">
    <a asp-controller="Prompts" asp-action="Index">Library</a><span aria-hidden="true">/</span>
    <a asp-controller="Prompts" asp-action="Details" asp-route-id="@Model.PromptId">@Model.PromptTitle</a><span aria-hidden="true">/</span>
    <a asp-action="Index" asp-route-promptId="@Model.PromptId">Runs</a><span aria-hidden="true">/</span>
    <span>#@Model.Id</span>
</nav>

<header class="pm-head">
    <div>
        <h1>Run #@Model.Id</h1>
        <p class="pm-sub">v@(Model.VersionNumber) of @Model.PromptTitle on <code>@Model.Model</code>, by @Model.RunBy.</p>
    </div>
    <div class="pm-actions"><partial name="_RunStatusBadge" model="Model.Status" /></div>
</header>

<div class="row g-4">
    <div class="col-xl-8">
        @if (Model.Status == PromptRunStatus.Failed)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }
        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <div class="alert alert-secondary">@Model.Note</div>
        }
        @if (Model.Status == PromptRunStatus.Truncated)
        {
            <div class="alert alert-warning">The answer stopped at the token limit and is incomplete.</div>
        }

        <section class="pm-sheet mb-4" aria-label="Output">
            <div class="pm-sheet-head"><span class="pm-sheet-title">Answer</span></div>
            @if (string.IsNullOrEmpty(Model.Output))
            {
                <p class="text-muted m-0 p-4">No output.</p>
            }
            else
            {
                <pre class="pm-output" data-testid="run-output">@Model.Output</pre>
            }
        </section>

        @if (Model.Variables.Any())
        {
            <h2 class="pm-section-title">Values</h2>
            <dl class="pm-values">
                @foreach (var (name, value) in Model.Variables)
                {
                    <dt><span class="pm-var">{{@name}}</span></dt>
                    <dd>@value</dd>
                }
            </dl>
        }

        <h2 class="pm-section-title">Text sent</h2>
        <section class="pm-sheet" aria-label="Prompt sent">
            <div class="pm-sheet-head"><span class="pm-sheet-title">v@(Model.VersionNumber), values filled in</span></div>
            <pre class="pm-lines pm-lines-plain">@PromptMarkup.Lines(Model.PromptText)</pre>
        </section>
    </div>

    <aside class="col-xl-4">
        <section class="card">
            <div class="card-body">
                <div class="pm-stat-label">Cost</div>
                <div class="pm-figure mb-3">$@Model.CostUsd.ToString("0.000000", inv)</div>
                <dl class="pm-facts">
                    <dt>Status</dt><dd>@Model.Status</dd>
                    <dt>Model</dt><dd><code>@Model.Model</code></dd>
                    @if (Model.ServedByModel is not null)
                    {
                        <dt>Answered by</dt><dd><code>@Model.ServedByModel</code> (fallback)</dd>
                    }
                    <dt>Input tokens</dt><dd class="pm-num">@Model.InputTokens.ToString("N0")</dd>
                    <dt>Output tokens</dt><dd class="pm-num">@Model.OutputTokens.ToString("N0")</dd>
                    <dt>Duration</dt><dd class="pm-num">@((Model.DurationMs / 1000.0).ToString("0.00", inv)) s</dd>
                    <dt>Stop reason</dt><dd>@(Model.StopReason ?? "none")</dd>
                    <dt>Run by</dt><dd>@Model.RunBy</dd>
                    <dt>At</dt><dd class="pm-num">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss", inv) UTC</dd>
                </dl>
            </div>
        </section>
    </aside>
</div>
