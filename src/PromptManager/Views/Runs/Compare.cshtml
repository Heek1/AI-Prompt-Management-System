@using System.Globalization
@using PromptManager.DTOs
@using PromptManager.ViewModels
@model CompareRunsViewModel
@{
    ViewData["Title"] = $"Runs #{Model.Left.Id} and #{Model.Right.Id}";
    var inv = CultureInfo.InvariantCulture;
    var runs = new[] { Model.Left, Model.Right };
    var diffModel = (Model.OutputDiff, $"Run #{Model.Left.Id} (v{Model.Left.VersionNumber})", $"Run #{Model.Right.Id} (v{Model.Right.VersionNumber})");
}

<nav class="pm-crumbs" aria-label="Breadcrumb">
    <a asp-controller="Prompts" asp-action="Index">Library</a><span aria-hidden="true">/</span>
    <a asp-controller="Prompts" asp-action="Details" asp-route-id="@Model.Left.PromptId">@Model.Left.PromptTitle</a><span aria-hidden="true">/</span>
    <span>Compare runs</span>
</nav>

<header class="pm-head">
    <div>
        <h1>Two answers, side by side</h1>
        <p class="pm-sub">Run #@Model.Left.Id on v@(Model.Left.VersionNumber) and run #@Model.Right.Id on v@(Model.Right.VersionNumber), same values.</p>
    </div>
</header>

<div class="row g-4 mb-4">
    @foreach (var r in runs)
    {
        <div class="col-lg-6">
            <section class="pm-sheet h-100">
                <div class="pm-sheet-head">
                    <div>
                        <a class="pm-sheet-title" asp-action="Details" asp-route-id="@r.Id">Run #@r.Id</a>
                        <span class="pm-sheet-meta ms-2">v@(r.VersionNumber), <code>@(r.ServedByModel ?? r.Model)</code></span>
                    </div>
                    <partial name="_RunStatusBadge" model="r.Status" />
                </div>
                <div class="pm-run-meta pm-num">
                    <span>@r.InputTokens.ToString("N0") in / @r.OutputTokens.ToString("N0") out</span>
                    <span>$@r.CostUsd.ToString("0.0000", inv)</span>
                    <span>@((r.DurationMs / 1000.0).ToString("0.0", inv)) s</span>
                </div>
                @if (r.Error is not null)
                {
                    <div class="alert alert-danger small mx-3">@r.Error</div>
                }
                <pre class="pm-output">@r.Output</pre>
            </section>
        </div>
    }
</div>

<h2 class="pm-section-title">What differs</h2>
<section class="pm-sheet">
    <partial name="_Diff" model="diffModel" />
</section>
