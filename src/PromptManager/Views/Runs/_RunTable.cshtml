@using System.Globalization
@using PromptManager.DTOs
@model (List<RunListItemDto> Runs, bool ShowPrompt)
@{
    var inv = CultureInfo.InvariantCulture;
}
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0 pm-table">
        <thead>
            <tr>
                <th>@T["When"]</th>
                @if (Model.ShowPrompt)
                {
                    <th>@T["Prompt"]</th>
                }
                <th>@T["Version"]</th>
                <th>@T["Model"]</th>
                <th>@T["Status"]</th>
                <th class="text-end">@T["Tokens in / out"]</th>
                <th class="text-end">@T["Cost"]</th>
                <th class="text-end">@T["Time"]</th>
                <th class="pm-col-by">@T["By"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Runs)
            {
                <tr>
                    <td class="text-nowrap pm-num">
                        <a asp-controller="Runs" asp-action="Details" asp-route-id="@r.Id">@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</a>
                    </td>
                    @if (Model.ShowPrompt)
                    {
                        <td>
                            <a asp-controller="Prompts" asp-action="Details" asp-route-id="@r.PromptId">@r.PromptTitle</a>
                        </td>
                    }
                    <td class="pm-num">v@(r.VersionNumber)</td>
                    <td><code>@r.Model</code></td>
                    <td><partial name="~/Views/Runs/_RunStatusBadge.cshtml" model="r.Status" /></td>
                    <td class="text-end text-nowrap pm-num">@r.InputTokens.ToString("N0") / @r.OutputTokens.ToString("N0")</td>
                    <td class="text-end pm-num">$@r.CostUsd.ToString("0.0000", inv)</td>
                    <td class="text-end text-nowrap pm-num">@((r.DurationMs / 1000.0).ToString("0.0", inv)) s</td>
                    <td class="pm-col-by">@r.RunBy</td>
                </tr>
            }
        </tbody>
    </table>
</div>
