@using PromptManager.DTOs
@model (List<RunListItemDto> Runs, bool ShowPrompt)
<div class="table-responsive">
    <table class="table table-hover table-sm align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>When</th>
                @if (Model.ShowPrompt)
                {
                    <th>Prompt</th>
                }
                <th>Version</th>
                <th>Model</th>
                <th>Status</th>
                <th class="text-end">Tokens in / out</th>
                <th class="text-end">Cost</th>
                <th class="text-end">Time</th>
                <th>By</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Runs)
            {
                <tr>
                    <td class="small text-nowrap">
                        <a asp-controller="Runs" asp-action="Details" asp-route-id="@r.Id">@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</a>
                    </td>
                    @if (Model.ShowPrompt)
                    {
                        <td class="small">
                            <a asp-controller="Prompts" asp-action="Details" asp-route-id="@r.PromptId">@r.PromptTitle</a>
                        </td>
                    }
                    <td><span class="badge bg-primary">v@(r.VersionNumber)</span></td>
                    <td class="small"><code>@r.Model</code></td>
                    <td><partial name="~/Views/Runs/_RunStatusBadge.cshtml" model="r.Status" /></td>
                    <td class="small text-end text-nowrap">@r.InputTokens.ToString("N0") / @r.OutputTokens.ToString("N0")</td>
                    <td class="small text-end">$@r.CostUsd.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td class="small text-end text-nowrap">@((r.DurationMs / 1000.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) s</td>
                    <td class="small">@r.RunBy</td>
                </tr>
            }
        </tbody>
    </table>
</div>
