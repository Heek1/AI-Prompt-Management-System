@using PromptManager.DTOs
@model RunPageDto
@{
    ViewData["Title"] = Model.PromptTitle is null ? "Runs" : $"Runs of {Model.PromptTitle}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-play-circle text-primary"></i> @ViewData["Title"]</h2>
    <span class="badge bg-secondary fs-6">@Model.TotalCount runs</span>
</div>

@if (Model.PromptId is not null)
{
    <p>
        <a asp-controller="Prompts" asp-action="Details" asp-route-id="@Model.PromptId">Back to the prompt</a>
        &middot; <a asp-action="Index">All runs</a>
    </p>
}

@if (!Model.Runs.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-4"></i>
        <p class="mt-3">No runs yet. Open a prompt and press <strong>Run</strong>.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <partial name="_RunTable" model="(Model.Runs, Model.PromptId is null)" />
        </div>
    </div>

    @if (Model.PageCount > 1)
    {
        <nav class="mt-3" aria-label="Runs pages">
            <ul class="pagination">
                @for (var i = 1; i <= Model.PageCount; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-promptId="@Model.PromptId" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
