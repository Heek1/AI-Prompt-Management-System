@using PromptManager.DTOs
@model EditPromptDto
@{
    ViewData["Title"] = "Edit prompt";
    var categories = (ViewBag.Categories as List<string>) ?? new List<string>();
    var tools = (ViewBag.AiTools as List<string>) ?? new List<string>();
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-pencil"></i> Edit prompt</h5>
            </div>
            <div class="card-body">
                <p class="small text-muted">The prompt text changes through <a asp-action="CreateVersion" asp-route-id="@Model.Id">a new version</a>, so its history is kept.</p>
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Category" class="form-label fw-semibold"></label>
                            <select asp-for="Category" class="form-select">
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AiTool" class="form-label fw-semibold">AI Tool</label>
                            <select asp-for="AiTool" class="form-select">
                                @foreach (var tool in tools)
                                {
                                    <option value="@tool">@tool</option>
                                }
                            </select>
                            <span asp-validation-for="AiTool" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
