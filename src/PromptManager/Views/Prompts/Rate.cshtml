@using PromptManager.DTOs
@model RatePromptDto
@{
    ViewData["Title"] = "Rate prompt";
    var prompt = ViewBag.Prompt as PromptManager.DTOs.PromptDetailsDto;
    var scale = new (int Value, string Label)[] { (1, "Poor"), (2, "Fair"), (3, "Good"), (4, "Great"), (5, "Excellent") };
}

<nav class="pm-crumbs" aria-label="Breadcrumb">
    <a asp-action="Index">Library</a><span aria-hidden="true">/</span>
    @if (prompt != null)
    {
        <a asp-action="Details" asp-route-id="@prompt.Id">@prompt.Title</a><span aria-hidden="true">/</span>
    }
    <span>Rate</span>
</nav>

<header class="pm-head">
    <div>
        <h1>How well does it work?</h1>
        @if (prompt != null)
        {
            <p class="pm-sub">@prompt.Title, by @prompt.Author. You can rate each prompt once.</p>
        }
    </div>
</header>

<form asp-action="Rate" method="post" class="pm-form-narrow">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PromptId" />

    <fieldset class="mb-4">
        <legend class="form-label">Rating</legend>
        <div class="pm-scale">
            @foreach (var (val, label) in scale)
            {
                <input type="radio" class="btn-check" name="Rating" id="rating-@val" value="@val" required @(Model.Rating == val ? "checked" : "") />
                <label class="pm-scale-step" for="rating-@val"><b>@val</b><span>@label</span></label>
            }
        </div>
        <span asp-validation-for="Rating" class="text-danger small"></span>
    </fieldset>

    <div class="mb-4">
        <label asp-for="Comment" class="form-label">Comment <span class="text-muted fw-normal">(optional)</span></label>
        <textarea asp-for="Comment" class="form-control" rows="3" placeholder="What worked, what did not"></textarea>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" style="display:@(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save rating</button>
        <a asp-action="Details" asp-route-id="@Model.PromptId" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
