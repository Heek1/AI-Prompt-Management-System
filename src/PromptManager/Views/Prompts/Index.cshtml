@using System.Globalization
@using PromptManager.ViewModels
@model PromptIndexViewModel
@inject PromptManager.Services.ICurrentUser CurrentUser
@{
    ViewData["Title"] = "Library";
    var inv = CultureInfo.InvariantCulture;
    var filtered = !string.IsNullOrWhiteSpace(Model.SearchQuery) || !string.IsNullOrWhiteSpace(Model.CategoryFilter)
                   || !string.IsNullOrWhiteSpace(Model.AiToolFilter) || !string.IsNullOrWhiteSpace(Model.TagFilter)
                   || Model.ShowArchived;
}

<header class="pm-head">
    <div>
        <h1>@(Model.ActiveTag is { } active ? "#" + active.Name : "Library")</h1>
        <p class="pm-sub">
            @Model.TotalCount @(Model.TotalCount == 1 ? "prompt" : "prompts")@(filtered ? " match these filters" : "")@(Model.PageCount > 1 ? $", page {Model.Page} of {Model.PageCount}" : "").
        </p>
    </div>
    <div class="pm-actions">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@T["Export"]</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/Prompts/Export?format=yaml">@T["All prompts, YAML"]</a></li>
                <li><a class="dropdown-item" href="/Prompts/Export?format=json">@T["All prompts, JSON"]</a></li>
                <li><a class="dropdown-item" href="/Prompts/ExportFolder">@T["Folder for git (.zip)"]</a></li>
            </ul>
        </div>
        @if (CurrentUser.IsSignedIn)
        {
            <a href="/Prompts/Import" class="btn btn-outline-secondary">@T["Import"]</a>
            <a asp-action="Create" class="btn btn-marker">@T["New prompt"]</a>
        }
    </div>
</header>

@if (Model.TagCounts.Any())
{
    <nav class="pm-collections" aria-label="@T["Collections"]">
        <a asp-action="Index" asp-route-showArchived="@(Model.ShowArchived ? "true" : null)"
           aria-current="@(string.IsNullOrEmpty(Model.TagFilter) ? "page" : null)">@T["All"]</a>
        @foreach (var t in Model.TagCounts.Take(16))
        {
            <a asp-action="Index" asp-route-tag="@t.Slug" asp-route-showArchived="@(Model.ShowArchived ? "true" : null)"
               aria-current="@(Model.TagFilter == t.Slug ? "page" : null)">#@t.Name <span>@t.Count</span></a>
        }
    </nav>
}

<form method="get" asp-action="Index" class="pm-filters" role="search">
    @if (!string.IsNullOrEmpty(Model.TagFilter))
    {
        <input type="hidden" name="tag" value="@Model.TagFilter" />
    }
    <div class="pm-search">
        <label class="form-label small" for="search">@T["Search"]</label>
        <input type="search" id="search" name="search" value="@Model.SearchQuery" class="form-control" placeholder="@T["Words, \"a phrase\" or -excluded"]" />
    </div>
    <div>
        <label class="form-label small" for="category">@T["Category"]</label>
        <select id="category" name="category" class="form-select">
            <option value="">@T["All"]</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat" selected="@(Model.CategoryFilter == cat)">@cat</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small" for="aiTool">@T["Tool"]</label>
        <select id="aiTool" name="aiTool" class="form-select">
            <option value="">@T["All"]</option>
            @foreach (var tool in Model.AiTools)
            {
                <option value="@tool" selected="@(Model.AiToolFilter == tool)">@tool</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label small" for="sortBy">@T["Sort by"]</label>
        <select id="sortBy" name="sortBy" class="form-select">
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <option value="relevance" selected="@(Model.SortBy == "relevance")">@T["Best match"]</option>
            }
            <option value="rating" selected="@(Model.SortBy == "rating")">@T["Rating"]</option>
            <option value="date" selected="@(Model.SortBy == "date")">@T["Newest"]</option>
            <option value="title" selected="@(Model.SortBy == "title")">@T["Title"]</option>
            <option value="version" selected="@(Model.SortBy == "version")">@T["Most versions"]</option>
        </select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@T["Filter"]</button>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">@T["Reset"]</a>
        }
    </div>
    <div class="form-check" style="grid-column: 1 / -1">
        <input class="form-check-input" type="checkbox" id="showArchived" name="showArchived" value="true" checked="@Model.ShowArchived" />
        <label class="form-check-label small" for="showArchived">@T["Show archived prompts"]</label>
    </div>
</form>

@if (!Model.Prompts.Any())
{
    <div class="pm-empty">
        @if (filtered)
        {
            <h2>@T["Nothing matches"]</h2>
            <p>@T["Try a shorter search or clear the filters."]</p>
            <a asp-action="Index" class="btn btn-outline-secondary">@T["Clear filters"]</a>
        }
        else
        {
            <h2>@T["The library is empty"]</h2>
            <p>@T["A prompt is a piece of text you give a model. Save it here to version it, run it and test it before anyone depends on it."]</p>
            @if (CurrentUser.IsSignedIn)
            {
                <a asp-action="Create" class="btn btn-marker">@T["Write the first prompt"]</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-marker">@T["Create an account to start"]</a>
            }
        }
    </div>
}
else
{
    <div class="pm-list">
        <div class="pm-row-head" aria-hidden="true">
            <span>@T["Prompt"]</span><span>@T["Release"]</span><span>@T["Rating"]</span><span>@T["Updated"]</span>
        </div>
        @foreach (var prompt in Model.Prompts)
        {
            <a class="pm-row @(prompt.IsArchived ? "is-archived" : "")" asp-action="Details" asp-route-id="@prompt.Id">
                <div style="min-width: 0">
                    <div class="pm-row-title">@prompt.Title</div>
                    <div class="pm-row-excerpt">@PromptManager.Infrastructure.PromptMarkup.Inline(prompt.Excerpt.ReplaceLineEndings(" "))</div>
                    <div class="pm-tags">
                        <span class="pm-tag">@prompt.Category</span>
                        <span class="pm-tag">@prompt.AiTool</span>
                        <span class="pm-tag">by @prompt.Author</span>
                        @foreach (var t in prompt.Tags)
                        {
                            <span class="pm-tag pm-tag-hash">#@t.Name</span>
                        }
                        @if (prompt.IsArchived)
                        {
                            <span class="pm-tag">@T["archived"]</span>
                        }
                    </div>
                </div>
                <div class="pm-row-meta">
                    @if (prompt.ProductionVersion is { } prod)
                    {
                        <span class="pm-status pm-status-production">v@(prod) live</span>
                    }
                    else
                    {
                        <span class="pm-status pm-status-draft">@T["not released"]</span>
                    }
                    @if (prompt.CurrentVersion != prompt.ProductionVersion)
                    {
                        <div class="small mt-1">v@(prompt.CurrentVersion) in draft</div>
                    }
                </div>
                <div class="pm-row-meta">
                    @if (prompt.AverageRating > 0)
                    {
                        <span class="pm-rating"><b>@prompt.AverageRating.ToString("0.0", inv)</b><span class="pm-gauge" aria-hidden="true"><i style="width: @((int)(prompt.AverageRating / 5 * 100))%"></i></span></span>
                    }
                    else
                    {
                        <span>@T["no ratings"]</span>
                    }
                </div>
                <div class="pm-row-meta pm-num">@prompt.UpdatedAt.ToString("dd MMM yyyy", inv)</div>
            </a>
        }
    </div>

    @if (Model.PageCount > 1)
    {
        <nav class="mt-4" aria-label="@T["Library pages"]">
            <ul class="pagination">
                @for (var i = 1; i <= Model.PageCount; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-search="@Model.SearchQuery" asp-route-category="@Model.CategoryFilter"
                           asp-route-aiTool="@Model.AiToolFilter" asp-route-tag="@Model.TagFilter" asp-route-sortBy="@Model.SortBy"
                           asp-route-showArchived="@(Model.ShowArchived ? "true" : null)" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
