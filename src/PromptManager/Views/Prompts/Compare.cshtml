@using PromptManager.ViewModels
@model CompareVersionsViewModel
@{
    ViewData["Title"] = $"Compare v{Model.From.VersionNumber} and v{Model.To.VersionNumber}";
    var p = Model.Prompt;
    var diffModel = (Model.Diff, $"v{Model.From.VersionNumber}", $"v{Model.To.VersionNumber}");
}

<nav class="pm-crumbs" aria-label="Breadcrumb">
    <a asp-action="Index">Library</a><span aria-hidden="true">/</span><a asp-action="Details" asp-route-id="@p.Id">@p.Title</a><span aria-hidden="true">/</span><span>Compare versions</span>
</nav>

<header class="pm-head">
    <div>
        <h1>v@(Model.From.VersionNumber) to v@(Model.To.VersionNumber)</h1>
        <p class="pm-sub">@(string.IsNullOrEmpty(Model.To.ChangeNote) ? "No change note on the newer version." : Model.To.ChangeNote)</p>
    </div>
    <form method="get" asp-action="Compare" asp-route-id="@p.Id" class="pm-actions align-items-end">
        <div>
            <label class="form-label small" for="from">From</label>
            <select id="from" name="from" class="form-select form-select-sm">
                @foreach (var v in p.Versions)
                {
                    <option value="@v.VersionNumber" selected="@(v.VersionNumber == Model.From.VersionNumber)">v@(v.VersionNumber)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small" for="to">To</label>
            <select id="to" name="to" class="form-select form-select-sm">
                @foreach (var v in p.Versions)
                {
                    <option value="@v.VersionNumber" selected="@(v.VersionNumber == Model.To.VersionNumber)">v@(v.VersionNumber)</option>
                }
            </select>
        </div>
        <button class="btn btn-outline-secondary btn-sm" type="submit">Compare</button>
    </form>
</header>

<section class="pm-sheet mb-4" aria-label="Changes">
    <partial name="_Diff" model="diffModel" />
</section>

@if (!p.IsArchived && !Model.IsSignedIn)
{
    <div class="alert alert-info">
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in</a> to run both versions side by side.
    </div>
}
@if (!p.IsArchived && Model.IsSignedIn)
{
    <section class="card" aria-labelledby="run-both-heading">
        <div class="card-header">
            <h2 class="h6 mb-0" id="run-both-heading">Run both versions side by side</h2>
        </div>
        <div class="card-body">
            <form asp-action="RunCompare" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PromptId" value="@p.Id" />
                <input type="hidden" name="FromVersion" value="@Model.From.VersionNumber" />
                <input type="hidden" name="ToVersion" value="@Model.To.VersionNumber" />
                @foreach (var name in Model.Variables)
                {
                    <div class="col-md-6">
                        <label class="form-label" for="cmp-var-@name"><span class="pm-var">{{@name}}</span></label>
                        <textarea id="cmp-var-@name" name="Variables[@name]" class="form-control" rows="2" maxlength="20000"></textarea>
                    </div>
                }
                <div class="col-md-9">
                    <label class="form-label" for="cmp-model">Model</label>
                    <select id="cmp-model" name="Model" class="form-select">
                        @foreach (var m in Model.Models)
                        {
                            <option value="@m.Model.Id" disabled="@(!m.IsAvailable)" selected="@(m.Model.Id == Model.DefaultModel)">
                                @m.Model.DisplayName@(m.IsAvailable ? "" : $" ({m.UnavailableReason})")
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-grid">
                    <button type="submit" class="btn btn-marker">Run both</button>
                </div>
            </form>
            <p class="form-text mb-0 mt-2">Both versions get the same model and the same values. This makes two calls and two runs.</p>
        </div>
    </section>
}
