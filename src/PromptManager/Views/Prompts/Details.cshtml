@using PromptManager.ViewModels
@model PromptDetailsViewModel
@{
    ViewData["Title"] = Model.Prompt.Title;
    var p = Model.Prompt;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">Library</a></li>
            <li class="breadcrumb-item active">@p.Title</li>
        </ol>
    </nav>
    <div class="d-flex gap-2 flex-wrap justify-content-end">
        <a asp-controller="Evals" asp-action="Index" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-ui-checks"></i> Evals
        </a>
        @if (p.CurrentVersion > 1)
        {
            <a asp-action="Compare" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-file-diff"></i> Compare versions
            </a>
        }
        @if (!p.IsArchived)
        {
            @if (Model.CanManage)
            {
                <a asp-action="CreateVersion" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-git"></i> New Version
                </a>
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            }
            @if (Model.IsSignedIn)
            {
                <a asp-action="Rate" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-star"></i> Rate
                </a>
            }
            @if (Model.CanManage)
            {
                <form asp-action="Archive" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@p.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                            data-confirm="Archive this prompt?">
                        <i class="bi bi-archive"></i> Archive
                    </button>
                </form>
            }
        }
        else
        {
            <span class="badge bg-secondary fs-6 py-2 px-3"><i class="bi bi-archive"></i> Archived</span>
            @if (Model.CanManage)
            {
                <form asp-action="Unarchive" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@p.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-arrow-counterclockwise"></i> Restore
                    </button>
                </form>
            }
        }
        @if (Model.CanManage)
        {
            <form asp-action="Delete" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@p.Id" />
                <button type="submit" class="btn btn-sm btn-outline-danger"
                        data-confirm="Delete this prompt with all its versions, ratings and runs? This cannot be undone.">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Main Prompt Card -->
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@p.Title</h5>
                <span class="badge bg-secondary">v@(p.CurrentVersion)</span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(p.Description))
                {
                    <p class="text-muted mb-3">@p.Description</p>
                    <hr />
                }

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                        <i class="bi bi-tag"></i> @p.Category
                    </span>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">
                        <i class="bi bi-robot"></i> @p.AiTool
                    </span>
                    <span class="badge bg-light text-dark border px-3 py-2">
                        <i class="bi bi-person"></i> @p.Author
                    </span>
                </div>

                <div class="bg-light rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted fw-semibold">PROMPT TEXT</small>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-target="#promptText">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                    </div>
                    <pre id="promptText" class="mb-0" style="white-space: pre-wrap; font-size: 0.9rem;">@p.CurrentText</pre>
                </div>

            </div>
            <div class="card-footer text-muted small">
                <i class="bi bi-calendar"></i> Created: @p.CreatedAt.ToString("dd MMM yyyy HH:mm")
                &nbsp;|&nbsp;
                <i class="bi bi-pencil"></i> Updated: @p.UpdatedAt.ToString("dd MMM yyyy HH:mm")
            </div>
        </div>

        <!-- Run -->
        @if (!p.IsArchived && !Model.IsSignedIn)
        {
            <div class="alert alert-light border mb-4">
                <i class="bi bi-play-circle text-primary"></i>
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in</a> to run this prompt on a model.
            </div>
        }
        @if (!p.IsArchived && Model.IsSignedIn)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-play-circle text-primary"></i> Run on a model</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Run" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PromptId" value="@p.Id" />
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold" for="run-model">Model</label>
                            <select id="run-model" name="Model" class="form-select form-select-sm">
                                @foreach (var m in Model.Models)
                                {
                                    <option value="@m.Model.Id" disabled="@(!m.IsAvailable)" selected="@(m.Model.Id == Model.RunForm.Model)">
                                        @m.Model.DisplayName@(m.IsAvailable ? "" : $" - {m.UnavailableReason}")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold" for="run-version">Version</label>
                            <select id="run-version" name="VersionNumber" class="form-select form-select-sm">
                                @foreach (var v in Model.Versions)
                                {
                                    <option value="@v.VersionNumber" selected="@(v.VersionNumber == p.CurrentVersion)">v@(v.VersionNumber)</option>
                                }
                            </select>
                        </div>
                        @if (Model.Variables.Any())
                        {
                            <div class="col-12 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-semibold">Variables</span>
                                    @if (Model.InputSets.Any())
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-box-arrow-in-down"></i> @(Model.SelectedInputSet?.Name ?? "Load input set")
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                @foreach (var set in Model.InputSets)
                                                {
                                                    <li><a class="dropdown-item small" asp-action="Details" asp-route-id="@p.Id" asp-route-inputSet="@set.Id">@set.Name</a></li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                                @foreach (var name in Model.Variables)
                                {
                                    var value = Model.SelectedInputSet?.Values.GetValueOrDefault(name) ?? "";
                                    <div class="mb-2">
                                        <label class="form-label small mb-0" for="var-@name"><code>{{@name}}</code></label>
                                        <textarea id="var-@name" name="Variables[@name]" class="form-control form-control-sm" rows="2" maxlength="20000">@value</textarea>
                                    </div>
                                }
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">Save these values as</span>
                                    <input name="SaveInputSetAs" class="form-control" maxlength="100" placeholder="optional name, e.g. short-input" value="@Model.SelectedInputSet?.Name" />
                                </div>
                            </div>
                        }
                        <div class="col-md-2 d-grid">
                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-play-fill"></i> Run</button>
                        </div>
                    </form>
                    @if (Model.InputSets.Any())
                    {
                        <details class="mt-2 small">
                            <summary class="text-muted">Saved input sets (@Model.InputSets.Count)</summary>
                            <ul class="list-unstyled mt-2 mb-0">
                                @foreach (var set in Model.InputSets)
                                {
                                    <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                                        <span><strong>@set.Name</strong> <span class="text-muted">(@string.Join(", ", set.Values.Keys))</span></span>
                                        @if (Model.CanManage)
                                        {
                                        <form asp-action="DeleteInputSet" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="promptId" value="@p.Id" />
                                            <input type="hidden" name="inputSetId" value="@set.Id" />
                                            <button type="submit" class="btn btn-link btn-sm text-danger p-0">Delete</button>
                                        </form>
                                        }
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                    <div class="form-text">The prompt text is sent to the selected provider. Write <code>{{name}}</code> in a prompt to add a variable. Runs are saved with tokens, cost and timing.</div>
                </div>
            </div>
        }

        <!-- Recent runs -->
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-list-check"></i> Recent runs</h6>
                @if (Model.TotalRuns > 0)
                {
                    <a asp-controller="Runs" asp-action="Index" asp-route-promptId="@p.Id" class="small">All @Model.TotalRuns runs</a>
                }
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentRuns.Any())
                {
                    <p class="text-muted p-3 mb-0 small">This prompt has not been run yet.</p>
                }
                else
                {
                    <partial name="~/Views/Runs/_RunTable.cshtml" model="(Model.RecentRuns, false)" />
                }
            </div>
        </div>

        @if (Model.IsAdmin && Model.BlockedPromotion is { } blocked)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center">
                <span><i class="bi bi-shield-exclamation"></i> As an admin you can promote v@(blocked) anyway. This is recorded on the version.</span>
                <form asp-action="Promote" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@p.Id" />
                    <input type="hidden" name="versionNumber" value="@blocked" />
                    <input type="hidden" name="overrideRegression" value="true" />
                    <button type="submit" class="btn btn-sm btn-warning" data-confirm="Promote v@(blocked) although its evals are worse?">Promote anyway</button>
                </form>
            </div>
        }

        <!-- Versions History -->
        <div class="card shadow-sm">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-clock-history"></i> Version History</h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.Versions.Any())
                {
                    <p class="text-muted p-3 mb-0">No versions yet.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var v in Model.Versions)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <span class="badge bg-primary me-1">v@(v.VersionNumber)</span>
                                        <partial name="_VersionStatusBadge" model="v.Status" />
                                        <strong class="ms-1">@(string.IsNullOrEmpty(v.ChangeNote) ? "No change note" : v.ChangeNote)</strong>
                                        <div class="text-muted small mt-1">
                                            <i class="bi bi-person"></i> @v.CreatedBy &nbsp;
                                            <i class="bi bi-calendar"></i> @v.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                            @if (v.Status == PromptManager.Models.VersionStatus.Production && v.PromotedAt is not null)
                                            {
                                                <span class="ms-2"><i class="bi bi-rocket-takeoff"></i> promoted @v.PromotedAt.Value.ToString("dd MMM yyyy") by @v.PromotedBy</span>
                                            }
                                            @if (v.PromotedOverRegression && v.Status == PromptManager.Models.VersionStatus.Production)
                                            {
                                                <span class="badge bg-danger ms-1" title="An admin promoted it although its evals were worse">over a regression</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="btn-group align-items-start">
                                        @if (Model.CanManage && !p.IsArchived && v.Status != PromptManager.Models.VersionStatus.Production)
                                        {
                                            var rollback = p.ProductionVersion is { } prod && v.VersionNumber < prod;
                                            <form asp-action="Promote" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <input type="hidden" name="versionNumber" value="@v.VersionNumber" />
                                                <button type="submit" class="btn btn-sm btn-outline-success"
                                                        title="@(rollback ? "Roll back production to" : "Promote to production"): v@(v.VersionNumber)"
                                                        data-confirm="@(rollback ? "Roll back" : "Promote") production to v@(v.VersionNumber)?">
                                                    <i class="bi @(rollback ? "bi-arrow-counterclockwise" : "bi-rocket-takeoff")"></i>
                                                    @(rollback ? "Roll back" : "Promote")
                                                </button>
                                            </form>
                                        }
                                        @if (v.VersionNumber > 1)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" title="Compare with v@(v.VersionNumber - 1)"
                                               asp-action="Compare" asp-route-id="@p.Id" asp-route-from="@(v.VersionNumber - 1)" asp-route-to="@v.VersionNumber">
                                                <i class="bi bi-file-diff"></i>
                                            </a>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary"
                                                type="button"
                                                title="Show text"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#version-@v.Id">
                                            <i class="bi bi-code-square"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="collapse mt-2" id="version-@v.Id">
                                    <pre class="bg-light p-2 rounded small mb-0" style="white-space: pre-wrap;">@v.PromptText</pre>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Rating Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-star-fill text-warning"></i> Rating</h6>
            </div>
            <div class="card-body text-center">
                <div class="display-4 fw-bold text-warning mb-1">@p.AverageRating.ToString("F1")</div>
                <div class="star-rating fs-4 mb-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= Math.Round(p.AverageRating) ? "bi-star-fill" : "bi-star") text-warning"></i>
                    }
                </div>
                <p class="text-muted small mb-0">Average Rating</p>
                @if (!p.IsArchived)
                {
                    <a asp-action="Rate" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning mt-2">
                        Rate this prompt
                    </a>
                }
            </div>
        </div>

        <!-- Details Card -->
        <div class="card shadow-sm">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Details</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-muted small">Category</td>
                        <td><span class="badge bg-primary bg-opacity-10 text-primary">@p.Category</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted small">AI Tool</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success">@p.AiTool</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted small">Author</td>
                        <td class="small">@p.Author</td>
                    </tr>
                    <tr>
                        <td class="text-muted small">API slug</td>
                        <td><code class="small" data-testid="slug">@p.Slug</code></td>
                    </tr>
                    <tr>
                        <td class="text-muted small">Latest</td>
                        <td><span class="badge bg-secondary">v@(p.CurrentVersion)</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted small">Production</td>
                        <td>
                            @if (p.ProductionVersion is { } production)
                            {
                                <span class="badge bg-success" data-testid="production-version">v@(production)</span>
                            }
                            else
                            {
                                <span class="text-muted small">none</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted small">Status</td>
                        <td>
                            @if (p.IsArchived)
                            {
                                <span class="badge bg-secondary">Archived</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
