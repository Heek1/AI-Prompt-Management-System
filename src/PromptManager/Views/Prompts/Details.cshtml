@using System.Globalization
@using PromptManager.Infrastructure
@using PromptManager.Models
@using PromptManager.ViewModels
@model PromptDetailsViewModel
@{
    ViewData["Title"] = Model.Prompt.Title;
    var p = Model.Prompt;
    var inv = CultureInfo.InvariantCulture;
    var latest = Model.Versions.FirstOrDefault(v => v.VersionNumber == p.CurrentVersion);
    var latestStatus = latest?.Status ?? VersionStatus.Draft;
    string StepClass(VersionStatus step) =>
        latestStatus == step ? "is-current"
        : (int)latestStatus > (int)step ? "is-done" : "";
}

<nav class="pm-crumbs" aria-label="Breadcrumb">
    <a asp-action="Index">Library</a><span aria-hidden="true">/</span><span>@p.Title</span>
</nav>

<header class="pm-head">
    <div style="min-width: 0; max-width: 760px">
        <h1>@p.Title</h1>
        @if (!string.IsNullOrWhiteSpace(p.Description))
        {
            <p class="pm-sub">@p.Description</p>
        }
        <div class="pm-tags mt-3">
            <span class="pm-tag">@p.Category</span>
            <span class="pm-tag">@p.AiTool</span>
            <span class="pm-tag">by @p.Author</span>
            @foreach (var t in p.Tags)
            {
                <a class="pm-tag pm-tag-link" asp-action="Index" asp-route-tag="@t.Slug">#@t.Name</a>
            }
            @if (p.IsArchived)
            {
                <span class="pm-status pm-status-draft">archived</span>
            }
        </div>
    </div>
    <div class="pm-actions">
        @if (Model.IsSignedIn)
        {
            <form action="/Prompts/Watch" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="promptId" value="@p.Id" />
                <input type="hidden" name="watch" value="@(Model.IsWatching ? "false" : "true")" />
                <button type="submit" class="btn btn-outline-secondary" aria-pressed="@(Model.IsWatching ? "true" : "false")">@(Model.IsWatching ? "Watching" : "Watch")</button>
            </form>
        }
        <a asp-controller="Evals" asp-action="Index" asp-route-id="@p.Id" class="btn btn-outline-secondary">Evals</a>
        @if (p.CurrentVersion > 1)
        {
            <a asp-action="Compare" asp-route-id="@p.Id" class="btn btn-outline-secondary">Compare versions</a>
        }
        @if (!p.IsArchived && Model.CanManage)
        {
            <a asp-action="CreateVersion" asp-route-id="@p.Id" class="btn btn-primary">New version</a>
        }
    </div>
</header>

@if (Model.IsAdmin && Model.BlockedPromotion is { } blocked)
{
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>As an admin you can promote v@(blocked) anyway. This is recorded on the version.</span>
        <form asp-action="Promote" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@p.Id" />
            <input type="hidden" name="versionNumber" value="@blocked" />
            <input type="hidden" name="overrideRegression" value="true" />
            <button type="submit" class="btn btn-sm btn-warning" data-confirm="Promote v@(blocked) although its evals are worse?">Promote anyway</button>
        </form>
    </div>
}

<div class="row g-4">
    <div class="col-xl-8">
        <section class="pm-sheet mb-4" aria-label="Prompt text">
            <div class="pm-sheet-head">
                <div>
                    <span class="pm-sheet-title">v@(p.CurrentVersion)</span>
                    <span class="pm-status pm-status-@(latestStatus.ToString().ToLowerInvariant()) ms-2">@latestStatus.ToString().ToLowerInvariant()</span>
                    <span class="pm-sheet-meta ms-2">@Model.Variables.Count @(Model.Variables.Count == 1 ? "variable" : "variables")</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-target="#promptText">Copy text</button>
            </div>
            <pre class="pm-lines" id="promptText">@PromptMarkup.Lines(p.CurrentText)</pre>
        </section>

        @if (!p.IsArchived && !Model.IsSignedIn)
        {
            <div class="alert alert-info mb-4">
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in</a> to run this prompt on a model.
            </div>
        }
        @if (!p.IsArchived && Model.IsSignedIn)
        {
            <section class="card mb-4" aria-labelledby="run-heading">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0" id="run-heading">Run on a model</h2>
                    @if (Model.InputSets.Any())
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @(Model.SelectedInputSet?.Name ?? "Load saved values")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @foreach (var set in Model.InputSets)
                                {
                                    <li><a class="dropdown-item small" asp-action="Details" asp-route-id="@p.Id" asp-route-inputSet="@set.Id">@set.Name</a></li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                <div class="card-body">
                    <form asp-action="Run" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PromptId" value="@p.Id" />
                        @if (Model.Variables.Any())
                        {
                            <div class="row g-3 mb-3">
                                @foreach (var name in Model.Variables)
                                {
                                    var value = Model.SelectedInputSet?.Values.GetValueOrDefault(name) ?? "";
                                    <div class="col-md-6">
                                        <label class="form-label" for="var-@name"><span class="pm-var">{{@name}}</span></label>
                                        <textarea id="var-@name" name="Variables[@name]" class="form-control" rows="2" maxlength="20000">@value</textarea>
                                    </div>
                                }
                            </div>
                        }
                        <div class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label" for="run-model">Model</label>
                                <select id="run-model" name="Model" class="form-select">
                                    @foreach (var m in Model.Models)
                                    {
                                        <option value="@m.Model.Id" disabled="@(!m.IsAvailable)" selected="@(m.Model.Id == Model.RunForm.Model)">
                                            @m.Model.DisplayName@(m.IsAvailable ? "" : $" ({m.UnavailableReason})")
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="run-version">Version</label>
                                <select id="run-version" name="VersionNumber" class="form-select">
                                    @foreach (var v in Model.Versions)
                                    {
                                        <option value="@v.VersionNumber" selected="@(v.VersionNumber == p.CurrentVersion)">v@(v.VersionNumber)</option>
                                    }
                                </select>
                            </div>
                            @if (Model.Variables.Any())
                            {
                                <div class="col-md-3">
                                    <label class="form-label" for="save-as">Save values as</label>
                                    <input id="save-as" name="SaveInputSetAs" class="form-control" maxlength="100" placeholder="optional" value="@Model.SelectedInputSet?.Name" />
                                </div>
                            }
                            <div class="col-md-2 d-grid">
                                <button type="submit" class="btn btn-marker">Run</button>
                            </div>
                        </div>
                    </form>
                    <p class="form-text mb-0 mt-2">The text goes to the selected provider. Every run is kept with its tokens, cost and time.</p>
                    @if (Model.InputSets.Any())
                    {
                        <details class="mt-3 small">
                            <summary class="text-muted">Saved values (@Model.InputSets.Count)</summary>
                            <ul class="list-unstyled mt-2 mb-0">
                                @foreach (var set in Model.InputSets)
                                {
                                    <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                                        <span><strong>@set.Name</strong> <span class="text-muted">@string.Join(", ", set.Values.Keys)</span></span>
                                        @if (Model.CanManage)
                                        {
                                            <form asp-action="DeleteInputSet" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="promptId" value="@p.Id" />
                                                <input type="hidden" name="inputSetId" value="@set.Id" />
                                                <button type="submit" class="btn btn-link btn-sm text-danger p-0">Delete</button>
                                            </form>
                                        }
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                </div>
            </section>
        }

        <h2 class="pm-section-title d-flex justify-content-between align-items-baseline">
            <span>Recent runs</span>
            @if (Model.TotalRuns > 0)
            {
                <a asp-controller="Runs" asp-action="Index" asp-route-promptId="@p.Id" class="small fw-normal">All @Model.TotalRuns runs</a>
            }
        </h2>
        @if (!Model.RecentRuns.Any())
        {
            <p class="text-muted">This prompt has not been run yet.</p>
        }
        else
        {
            <div class="pm-list">
                <partial name="~/Views/Runs/_RunTable.cshtml" model="(Model.RecentRuns, false)" />
            </div>
        }

        <h2 class="pm-section-title">History</h2>
        <ol class="pm-history">
            @foreach (var v in Model.Versions)
            {
                var rollback = p.ProductionVersion is { } prod && v.VersionNumber < prod;
                <li class="pm-history-item @(v.Status == VersionStatus.Production ? "is-live" : "")" id="v@(v.VersionNumber)">
                    <div class="pm-history-head">
                        <div>
                            <span class="pm-history-version">v@(v.VersionNumber)</span>
                            <partial name="_VersionStatusBadge" model="v.Status" />
                            @if (v.PromotedOverRegression && v.Status == VersionStatus.Production)
                            {
                                <span class="pm-status pm-status-failed" title="An admin promoted it although its evals were worse">over a regression</span>
                            }
                            <div class="pm-history-note">@(string.IsNullOrEmpty(v.ChangeNote) ? "No change note" : v.ChangeNote)</div>
                            <div class="text-muted small">
                                @v.CreatedBy, @v.CreatedAt.ToString("dd MMM yyyy HH:mm", inv)@(v.Status == VersionStatus.Production && v.PromotedAt is not null ? $"; live since {v.PromotedAt.Value.ToString("dd MMM yyyy", inv)}, promoted by {v.PromotedBy}" : "")
                            </div>
                        </div>
                        <div class="pm-inline-actions">
                            @if (Model.CanManage && !p.IsArchived && v.Status != VersionStatus.Production)
                            {
                                <form asp-action="Promote" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="versionNumber" value="@v.VersionNumber" />
                                    <button type="submit" class="btn btn-sm @(rollback ? "btn-outline-secondary" : "btn-outline-success")"
                                            data-confirm="@(rollback ? "Roll back" : "Promote") production to v@(v.VersionNumber)?">
                                        @(rollback ? "Roll back" : "Promote")
                                    </button>
                                </form>
                            }
                            @if (v.VersionNumber > 1)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Compare" asp-route-id="@p.Id" asp-route-from="@(v.VersionNumber - 1)" asp-route-to="@v.VersionNumber">Diff</a>
                            }
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#version-@v.Id" aria-expanded="false" aria-controls="version-@v.Id">Text</button>
                        </div>
                    </div>
                    <div class="collapse" id="version-@v.Id">
                        <pre class="pm-lines pm-lines-compact">@PromptMarkup.Lines(v.PromptText)</pre>
                    </div>
                    @{
                        var comments = Model.Comments.GetValueOrDefault(v.VersionNumber) ?? [];
                    }
                    @if (comments.Any() || (Model.IsSignedIn && !p.IsArchived))
                    {
                        <details class="pm-comments" open="@(comments.Any() ? "open" : null)">
                            <summary>@(comments.Count == 0 ? "Comment" : comments.Count == 1 ? "1 comment" : $"{comments.Count} comments")</summary>
                            @foreach (var c in comments)
                            {
                                <div class="pm-comment">
                                    <div class="pm-comment-meta">
                                        <strong>@c.AuthorName</strong> <span class="pm-num">@c.CreatedAt.ToString("dd MMM yyyy HH:mm", inv)</span>
                                        @if (Model.IsAdmin || c.AuthorId == Model.CurrentUserId)
                                        {
                                            <form action="/Prompts/DeleteComment" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="promptId" value="@p.Id" />
                                                <input type="hidden" name="commentId" value="@c.Id" />
                                                <input type="hidden" name="versionNumber" value="@v.VersionNumber" />
                                                <button type="submit" class="btn btn-link btn-sm p-0 ms-2 text-danger" data-confirm="Delete this comment?">Delete</button>
                                            </form>
                                        }
                                    </div>
                                    <div class="pm-comment-body">@c.Body</div>
                                </div>
                            }
                            @if (Model.IsSignedIn && !p.IsArchived)
                            {
                                <form action="/Prompts/Comment" method="post" class="pm-comment-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="promptId" value="@p.Id" />
                                    <input type="hidden" name="versionNumber" value="@v.VersionNumber" />
                                    <label class="visually-hidden" for="comment-@v.Id">Comment on v@(v.VersionNumber)</label>
                                    <textarea id="comment-@v.Id" name="body" class="form-control" rows="2" maxlength="2000" placeholder="What works, what does not, what to try next"></textarea>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary mt-2">Comment on v@(v.VersionNumber)</button>
                                </form>
                            }
                        </details>
                    }
                </li>
            }
        </ol>
    </div>

    <aside class="col-xl-4">
        <section class="card mb-4" aria-labelledby="release-heading">
            <div class="card-body">
                <h2 class="h6" id="release-heading">Release</h2>
                <ol class="pm-track my-3" aria-label="Release track of v@(p.CurrentVersion)">
                    <li class="@StepClass(VersionStatus.Draft)">Draft</li>
                    <li class="@StepClass(VersionStatus.Tested)">Tested</li>
                    <li class="@StepClass(VersionStatus.Production)">Production</li>
                </ol>
                <dl class="pm-facts">
                    <dt>In production</dt>
                    <dd>
                        @if (p.ProductionVersion is { } production)
                        {
                            <span class="pm-status pm-status-production" data-testid="production-version">v@(production)</span>
                        }
                        else
                        {
                            <span class="text-muted">none</span>
                        }
                    </dd>
                    <dt>Latest</dt>
                    <dd>v@(p.CurrentVersion)</dd>
                    <dt>API slug</dt>
                    <dd><code data-testid="slug">@p.Slug</code></dd>
                </dl>
                <p class="small text-muted mt-3 mb-0">Applications read the production version from <code>/api/prompts/@p.Slug</code>.</p>
                <p class="small mt-2 mb-0">Export: <a href="/Prompts/Export/@p.Id?format=yaml">YAML</a>, <a href="/Prompts/Export/@p.Id?format=json">JSON</a></p>
            </div>
        </section>

        <section class="card mb-4" aria-labelledby="rating-heading">
            <div class="card-body">
                <h2 class="h6" id="rating-heading">Rating</h2>
                @if (p.AverageRating > 0)
                {
                    <div class="d-flex align-items-baseline gap-2 mt-2">
                        <span class="pm-figure">@p.AverageRating.ToString("0.0", inv)</span>
                        <span class="text-muted">out of 5</span>
                    </div>
                    <div class="pm-gauge mt-2" style="width: 100%" aria-hidden="true"><i style="width: @((int)(p.AverageRating / 5 * 100))%"></i></div>
                }
                else
                {
                    <p class="text-muted mt-2 mb-0">No ratings yet.</p>
                }
                @if (!p.IsArchived && Model.IsSignedIn)
                {
                    <a asp-action="Rate" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary mt-3">Rate this prompt</a>
                }
            </div>
        </section>

        <section class="card mb-4" aria-labelledby="facts-heading">
            <div class="card-body">
                <h2 class="h6" id="facts-heading">Details</h2>
                <dl class="pm-facts mt-2">
                    <dt>Category</dt><dd>@p.Category</dd>
                    <dt>Tool</dt><dd>@p.AiTool</dd>
                    <dt>Author</dt><dd>@p.Author</dd>
                    <dt>Status</dt><dd>@(p.IsArchived ? "Archived" : "Active")</dd>
                </dl>
                <p class="small text-muted mt-3 mb-0">
                    Created: @p.CreatedAt.ToString("dd MMM yyyy HH:mm", inv)<br />
                    Updated: @p.UpdatedAt.ToString("dd MMM yyyy HH:mm", inv)
                </p>
            </div>
        </section>

        @if (Model.CanManage)
        {
            <section class="card" aria-labelledby="manage-heading">
                <div class="card-body">
                    <h2 class="h6" id="manage-heading">Manage</h2>
                    <div class="pm-inline-actions mt-2">
                        @if (!p.IsArchived)
                        {
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit details</a>
                            <form asp-action="Archive" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" data-confirm="Archive this prompt?">Archive</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Unarchive" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                            </form>
                        }
                        <form asp-action="Delete" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    data-confirm="Delete this prompt with all its versions, ratings and runs? This cannot be undone.">Delete</button>
                        </form>
                    </div>
                </div>
            </section>
        }
    </aside>
</div>
