@{
    ViewData["Title"] = "Not allowed";
}

<section class="pm-error">
    <div class="pm-error-code" aria-hidden="true">403</div>
    <h1>@T["Not yours to change"]</h1>
    <p class="pm-sub">@T["Only the prompt's author or an admin can do that."]</p>
    <a class="btn btn-primary mt-3" asp-controller="Prompts" asp-action="Index">@T["Back to the library"]</a>
</section>
