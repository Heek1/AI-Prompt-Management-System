@using System.Globalization
@using PromptManager.Models
@using PromptManager.ViewModels
@model ModelComparisonViewModel
@{
    ViewData["Title"] = "Model comparison";
    var inv = CultureInfo.InvariantCulture;
    var f = Model.First;
    var finished = Model.Rows.Where(r => r.Eval.Status == EvalRunStatus.Completed).ToList();
    var best = finished.Count == 0 ? null : finished.MaxBy(r => (r.Eval.PassRate ?? 0, -(double)r.Eval.CostUsd));
}
@section Head {
    @if (!Model.AllFinished)
    {
        <meta http-equiv="refresh" content="2" />
    }
}

<nav class="pm-crumbs" aria-label="Breadcrumb">
    <a asp-controller="Prompts" asp-action="Details" asp-route-id="@f.PromptId">@f.PromptTitle</a><span aria-hidden="true">/</span>
    <a asp-action="Index" asp-route-id="@f.PromptId">Evals</a><span aria-hidden="true">/</span>
    <span>Model comparison</span>
</nav>

<header class="pm-head">
    <div>
        <h1>Which model, for v@(f.VersionNumber)?</h1>
        <p class="pm-sub">
            The same @f.TotalCases @(f.TotalCases == 1 ? "case" : "cases") on each model@(f.JudgeModel is null ? "" : $", graded by {f.JudgeModel}").
            @if (!Model.AllFinished)
            {
                <span>Still running; this page refreshes itself.</span>
            }
        </p>
    </div>
</header>

<div class="pm-list">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pm-table" data-testid="comparison-table">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>Passed</th>
                    <th class="text-end">Cost</th>
                    <th class="text-end">Tokens in / out</th>
                    <th class="text-end">Avg. time per answer</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var e = row.Eval;
                    var isBest = row == best && finished.Count > 1;
                    <tr class="@(isBest ? "pm-best" : "")">
                        <td>
                            <div class="fw-semibold">@row.DisplayName @if (isBest) { <span class="pm-status pm-status-production ms-1">best</span> }</div>
                            <div class="small text-muted"><code>@e.Model</code></div>
                        </td>
                        <td>
                            @if (e.Status == EvalRunStatus.Completed)
                            {
                                <span class="pm-pass pm-num">
                                    <span class="fw-semibold">@e.PassedCases / @e.TotalCases</span>
                                    <span class="pm-gauge @(e.PassedCases == e.TotalCases ? "is-pass" : "is-fail")" aria-hidden="true"><i style="width: @(((e.PassRate ?? 0) * 100).ToString("0", inv))%"></i></span>
                                    <span class="small text-muted">@(((e.PassRate ?? 0) * 100).ToString("0", inv))%</span>
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">@e.Status.ToString().ToLowerInvariant() (@e.CompletedCases/@e.TotalCases)</span>
                            }
                        </td>
                        <td class="text-end pm-num">$@e.CostUsd.ToString("0.0000", inv)</td>
                        <td class="text-end pm-num">@row.InputTokens.ToString("N0") / @row.OutputTokens.ToString("N0")</td>
                        <td class="text-end pm-num">@(row.AverageSeconds is { } s ? s.ToString("0.0", inv) + " s" : "-")</td>
                        <td class="text-end"><a asp-action="Run" asp-route-id="@e.Id" class="small">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (best is not null && finished.Count > 1)
{
    <p class="small text-muted mt-2">Best: the highest pass rate, and the lower cost when pass rates tie.</p>
}
