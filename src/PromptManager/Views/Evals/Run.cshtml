@using System.Globalization
@using PromptManager.DTOs
@using PromptManager.Models
@model EvalRunDetailsDto
@{
    ViewData["Title"] = $"Eval #{Model.Id}";
    var inv = CultureInfo.InvariantCulture;
    var percent = Model.TotalCases == 0 ? 0 : (int)Math.Round(100.0 * Model.CompletedCases / Model.TotalCases);
    var pending = Math.Max(0, Model.TotalCases - Model.Results.Count);
}
@section Head {
    @if (!Model.IsFinished)
    {
        @* Plain reload keeps the page free of scripts; stops once the eval is finished. *@
        <meta http-equiv="refresh" content="2" />
    }
}

<nav class="pm-crumbs" aria-label="Breadcrumb">
    <a asp-controller="Prompts" asp-action="Details" asp-route-id="@Model.PromptId">@Model.PromptTitle</a><span aria-hidden="true">/</span>
    <a asp-action="Index" asp-route-id="@Model.PromptId">Evals</a><span aria-hidden="true">/</span>
    <span>#@Model.Id</span>
</nav>

<header class="pm-head">
    <div>
        <h1>Eval #@Model.Id</h1>
        <p class="pm-sub">
            v@(Model.VersionNumber) on <code>@Model.Model</code>. @(Model.JudgeModel is null ? "No judge." : $"Judge: {Model.JudgeModel}.")
            Run by @Model.RunBy, $@Model.CostUsd.ToString("0.0000", inv).
        </p>
    </div>
    <div class="pm-actions text-end">
        @if (Model.Status == EvalRunStatus.Completed)
        {
            <div>
                <div class="pm-figure pm-figure-xl @(Model.PassedCases == Model.TotalCases ? "is-pass" : "is-fail")" data-testid="pass-rate">
                    @Model.PassedCases / @Model.TotalCases
                </div>
                <div class="pm-stat-label">cases passed</div>
            </div>
        }
        else
        {
            <div class="pm-status pm-status-draft" data-testid="eval-status">@Model.Status</div>
        }
    </div>
</header>

<section class="card mb-4" aria-label="Signal strip">
    <div class="card-body">
        <div class="pm-signal pm-signal-lg" role="list" aria-label="One cell per case">
            @foreach (var r in Model.Results)
            {
                <span role="listitem" class="@(r.Passed ? "is-pass" : "is-fail")" title="@r.CaseName: @(r.Passed ? "passed" : "failed")"></span>
            }
            @for (var i = 0; i < pending; i++)
            {
                <span role="listitem" title="Waiting"></span>
            }
        </div>

        @if (!Model.IsFinished)
        {
            <div class="progress mt-3" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" aria-label="Cases done">
                <div class="progress-bar" style="width: @percent%"></div>
            </div>
            <p class="small text-muted mt-2 mb-0">@Model.CompletedCases of @Model.TotalCases done. This page refreshes itself.</p>
        }

        @if (Model.Error is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@Model.Error</div>
        }

        @if (Model.Previous is { } prev && Model.Status == EvalRunStatus.Completed)
        {
            <div class="alert @(Model.IsRegression ? "alert-danger" : "alert-success") mt-3 mb-0" data-testid="comparison">
                @if (Model.IsRegression)
                {
                    <strong>Worse than v@(prev.VersionNumber)</strong>
                }
                else
                {
                    <span>Not worse than v@(prev.VersionNumber)</span>
                }
                on this model: @prev.PassedCases/@prev.TotalCases before, @Model.PassedCases/@Model.TotalCases now
                (<a asp-action="Run" asp-route-id="@prev.Id">eval #@prev.Id</a>).
            </div>
        }
    </div>
</section>

@if (ViewData["SuggestModels"] is List<PromptManager.Llm.AvailableModel> suggestModels)
{
    <section class="card pm-suggest mb-4" aria-labelledby="suggest-heading">
        <div class="card-body d-flex flex-wrap gap-3 align-items-end justify-content-between">
            <div style="max-width: 560px">
                <h2 class="h6 mb-1" id="suggest-heading">Ask a model to fix it</h2>
                <p class="small text-muted mb-0">
                    The model sees v@(Model.VersionNumber), the failed cases with their answers and checks, and the names of the cases that passed.
                    You review the change as a diff before anything is saved; accepting it saves a draft and runs this eval again.
                </p>
            </div>
            @if (suggestModels.Any(m => m.IsAvailable))
            {
                <form asp-action="Suggest" method="post" class="d-flex gap-2 align-items-end">
                    <input type="hidden" name="evalRunId" value="@Model.Id" />
                    <div>
                        <label class="form-label small" for="suggest-model">Model</label>
                        <select id="suggest-model" name="model" class="form-select">
                            @foreach (var m in suggestModels)
                            {
                                <option value="@m.Model.Id" disabled="@(!m.IsAvailable)">@m.Model.DisplayName@(m.IsAvailable ? "" : $" ({m.UnavailableReason})")</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-marker text-nowrap">Suggest a fix</button>
                </form>
            }
            else
            {
                <p class="small mb-0">No model that can write prompts is configured here; the echo model only repeats its input.</p>
            }
        </div>
    </section>
}

<h2 class="pm-section-title">Cases</h2>
<ul class="pm-cases">
    @foreach (var r in Model.Results)
    {
        <li class="pm-case @(r.Passed ? "is-pass" : "is-fail")">
            <div class="d-flex justify-content-between gap-3">
                <div class="pm-case-name">
                    @if (r.Passed)
                    {
                        <i class="bi bi-check-circle-fill" aria-label="Passed"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill" aria-label="Failed"></i>
                    }
                    @r.CaseName
                </div>
                @if (r.PromptRunId is not null)
                {
                    <a asp-controller="Runs" asp-action="Details" asp-route-id="@r.PromptRunId" class="small">Answer</a>
                }
            </div>
            <ul class="pm-checks">
                @foreach (var check in r.Checks)
                {
                    <li class="@(check.Passed ? "is-pass" : "is-fail")">
                        @check.Name: <span class="text-body">@check.Detail</span>
                    </li>
                }
            </ul>
        </li>
    }
    @if (!Model.Results.Any())
    {
        <li class="text-muted">No results yet.</li>
    }
</ul>
