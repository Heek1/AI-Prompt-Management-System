@using System.Globalization
@using PromptManager.DTOs
@using PromptManager.Models
@model EvalRunDetailsDto
@{
    ViewData["Title"] = $"Eval #{Model.Id}";
    var inv = CultureInfo.InvariantCulture;
    var percent = Model.TotalCases == 0 ? 0 : (int)Math.Round(100.0 * Model.CompletedCases / Model.TotalCases);
    var pending = Math.Max(0, Model.TotalCases - Model.Results.Count);
}
@section Head {
    @if (!Model.IsFinished)
    {
        @* Plain reload keeps the page free of scripts; stops once the eval is finished. *@
        <meta http-equiv="refresh" content="2" />
    }
}

<nav class="pm-crumbs" aria-label="@T["Breadcrumb"]">
    <a asp-controller="Prompts" asp-action="Details" asp-route-id="@Model.PromptId">@Model.PromptTitle</a><span aria-hidden="true">/</span>
    <a asp-action="Index" asp-route-id="@Model.PromptId">Evals</a><span aria-hidden="true">/</span>
    <span>#@Model.Id</span>
</nav>

<header class="pm-head">
    <div>
        <h1>Eval #@Model.Id</h1>
        <p class="pm-sub">
            @T["v{0} on", Model.VersionNumber] <code>@Model.Model</code>. @(Model.JudgeModel is null ? T["No judge."].Value : T["Judge: {0}.", Model.JudgeModel].Value)
            @T["Run by {0}", Model.RunBy], $@Model.CostUsd.ToString("0.0000", inv).
        </p>
    </div>
    <div class="pm-actions text-end">
        @if (Model.Status == EvalRunStatus.Completed)
        {
            <div>
                <div class="pm-figure pm-figure-xl @(Model.PassedCases == Model.TotalCases ? "is-pass" : "is-fail")" data-testid="pass-rate">
                    @Model.PassedCases / @Model.TotalCases
                </div>
                <div class="pm-stat-label">@T["cases passed"]</div>
            </div>
        }
        else
        {
            <div class="pm-status pm-status-draft" data-testid="eval-status">@T[Model.Status.ToString()]</div>
        }
    </div>
</header>

<section class="card mb-4" aria-label="@T["Signal strip"]">
    <div class="card-body">
        <div class="pm-signal pm-signal-lg" role="list" aria-label="@T["One cell per case"]">
            @foreach (var r in Model.Results)
            {
                <span role="listitem" class="@(r.Passed ? "is-pass" : "is-fail")" title="@r.CaseName: @(r.Passed ? T.Text("case:passed", "passed") : T.Text("case:failed", "failed"))"></span>
            }
            @for (var i = 0; i < pending; i++)
            {
                <span role="listitem" title="@T["Waiting"]"></span>
            }
        </div>

        @if (!Model.IsFinished)
        {
            <div class="progress mt-3" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" aria-label="@T["Cases done"]">
                <div class="progress-bar" style="width: @percent%"></div>
            </div>
            <p class="small text-muted mt-2 mb-0">@T["{0} of {1} done. This page refreshes itself.", Model.CompletedCases, Model.TotalCases]</p>
        }

        @if (Model.Error is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@T.Message(Model.Error)</div>
        }

        @if (Model.Previous is { } prev && Model.Status == EvalRunStatus.Completed)
        {
            <div class="alert @(Model.IsRegression ? "alert-danger" : "alert-success") mt-3 mb-0" data-testid="comparison">
                @if (Model.IsRegression)
                {
                    <strong>@T["Worse than v{0}", prev.VersionNumber]</strong>
                }
                else
                {
                    <span>@T["Not worse than v{0}", prev.VersionNumber]</span>
                }
                @T["on this model: {0}/{1} before, {2}/{3} now", prev.PassedCases, prev.TotalCases, Model.PassedCases, Model.TotalCases]
                (<a asp-action="Run" asp-route-id="@prev.Id">eval #@prev.Id</a>).
            </div>
        }
    </div>
</section>

@if (ViewData["SuggestModels"] is List<PromptManager.Llm.AvailableModel> suggestModels)
{
    <section class="card pm-suggest mb-4" aria-labelledby="suggest-heading">
        <div class="card-body d-flex flex-wrap gap-3 align-items-end justify-content-between">
            <div style="max-width: 560px">
                <h2 class="h6 mb-1" id="suggest-heading">@T["Ask a model to fix it"]</h2>
                <p class="small text-muted mb-0">
                    @T["The model sees v{0}, the failed cases with their answers and checks, and the names of the cases that passed. You review the change as a diff before anything is saved; accepting it saves a draft and runs this eval again.", Model.VersionNumber]
                </p>
            </div>
            @if (suggestModels.Any(m => m.IsAvailable))
            {
                <form asp-action="Suggest" method="post" class="d-flex gap-2 align-items-end">
                    <input type="hidden" name="evalRunId" value="@Model.Id" />
                    <div>
                        <label class="form-label small" for="suggest-model">@T["Model"]</label>
                        <select id="suggest-model" name="model" class="form-select">
                            @foreach (var m in suggestModels)
                            {
                                <option value="@m.Model.Id" disabled="@(!m.IsAvailable)">@m.Model.DisplayName@(m.IsAvailable ? "" : $" ({m.UnavailableReason})")</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-marker text-nowrap">@T["Suggest a fix"]</button>
                </form>
            }
            else
            {
                <p class="small mb-0">@T["No model that can write prompts is configured here; the echo model only repeats its input."]</p>
            }
        </div>
    </section>
}

<h2 class="pm-section-title">@T["Cases"]</h2>
<ul class="pm-cases">
    @foreach (var r in Model.Results)
    {
        <li class="pm-case @(r.Passed ? "is-pass" : "is-fail")">
            <div class="d-flex justify-content-between gap-3">
                <div class="pm-case-name">
                    @if (r.Passed)
                    {
                        <i class="bi bi-check-circle-fill" aria-label="@T["Passed"]"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill" aria-label="@T["Failed"]"></i>
                    }
                    @r.CaseName
                </div>
                @if (r.PromptRunId is not null)
                {
                    <a asp-controller="Runs" asp-action="Details" asp-route-id="@r.PromptRunId" class="small">@T["Answer"]</a>
                }
            </div>
            <ul class="pm-checks">
                @foreach (var check in r.Checks)
                {
                    <li class="@(check.Passed ? "is-pass" : "is-fail")">
                        @check.Name: <span class="text-body">@check.Detail</span>
                    </li>
                }
            </ul>
        </li>
    }
    @if (!Model.Results.Any())
    {
        <li class="text-muted">@T["No results yet."]</li>
    }
</ul>
