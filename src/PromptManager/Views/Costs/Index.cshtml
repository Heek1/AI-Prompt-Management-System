@using PromptManager.Infrastructure
@using System.Globalization
@using PromptManager.Services
@model CostSummary
@{
    ViewData["Title"] = "Costs";
    var inv = CultureInfo.InvariantCulture;
    // Four decimals for small amounts (a single call costs fractions of a cent), two otherwise.
    string Usd(decimal v) => "$" + v.ToString(v == 0 || v >= 1 ? "0.00" : "0.0000", inv);

    // Bar chart geometry (SVG units). One series, so no legend: the title names it.
    const int width = 720, height = 180, left = 44, right = 8, top = 16, bottom = 24;
    var days = Model.Last30Days;
    var max = days.Count == 0 ? 0m : days.Max(d => d.CostUsd);
    var scaleMax = max <= 0 ? 1m : max * 1.15m;
    var slot = (double)(width - left - right) / Math.Max(1, days.Count);
    var barWidth = Math.Min(16, slot - 2); // capped thickness, the rest is air
    double Y(decimal v) => top + (height - top - bottom) * (1 - (double)(v / scaleMax));
    var baseline = height - bottom;
    var peak = days.Where(d => d.CostUsd > 0).OrderByDescending(d => d.CostUsd).FirstOrDefault();
}

<header class="pm-head">
    <div>
        <h1>@T["Costs"]</h1>
        <p class="pm-sub">@T["Paid model calls: runs (including eval answers) and judge calls. Days are UTC."]</p>
    </div>
</header>

<div class="pm-ledger mb-4">
    <div>
        <div class="pm-stat-label">@T["Today"]</div>
        <div class="pm-figure" data-testid="cost-today">@Usd(Model.Today)</div>
    </div>
    <div>
        <div class="pm-stat-label">@T["Last 7 days"]</div>
        <div class="pm-figure">@Usd(Model.Last7Days)</div>
    </div>
    <div>
        <div class="pm-stat-label">@T["This month"]</div>
        <div class="pm-figure" data-testid="cost-month">@Usd(Model.MonthToDate)</div>
        @if (Model.JudgeMonthToDate > 0)
        {
            <div class="small text-muted">@T["of which judges {0}", Usd(Model.JudgeMonthToDate)]</div>
        }
    </div>
    <div>
        <div class="pm-stat-label">@T["Monthly budget"]</div>
            @if (Model.HasBudget)
            {
                <div class="pm-figure">@Usd(Model.Remaining) <span class="fs-6 text-muted fw-normal">@T["left of {0}", Usd(Model.MonthlyBudget)]</span></div>
                <div class="progress mt-2" style="height: 6px" role="progressbar" aria-label="@T["Budget used"]"
                     aria-valuenow="@((int)(Model.BudgetUsed * 100))" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(Model.BudgetUsed >= 1 ? "bg-danger" : Model.BudgetUsed >= 0.8 ? "bg-warning" : "")"
                         style="width: @(Math.Min(100, (int)(Model.BudgetUsed * 100)))%"></div>
                </div>
                @if (Model.BudgetUsed >= 1)
                {
                    <div class="small text-danger mt-1">@T["Used up: paid calls are refused until the 1st."]</div>
                }
            }
            else
            {
                <div class="text-muted mt-2">@T["No limit. Set"] <code>Llm:MonthlyBudgetUsd</code>.</div>
            }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h2 class="h6 mb-0">@T["Spend per day, last 30 days"]</h2></div>
    <div class="card-body">
        <svg viewBox="0 0 @width @height" class="w-100" role="img" aria-label="@T["Spend per day for the last 30 days; the table below lists the same numbers"]" data-testid="daily-chart">
            @* Recessive grid: baseline and the top value only. *@
            <line x1="@left" x2="@(width - right)" y1="@baseline" y2="@baseline" stroke="#c9cedc" stroke-width="1" />
            <line x1="@left" x2="@(width - right)" y1="@Y(scaleMax).ToString(inv)" y2="@Y(scaleMax).ToString(inv)" stroke="#eceef5" stroke-width="1" />
            <text x="@(left - 6)" y="@((Y(scaleMax) + 4).ToString(inv))" text-anchor="end" font-size="10" fill="#6b7390">@Usd(scaleMax)</text>
            <text x="@(left - 6)" y="@(baseline + 4)" text-anchor="end" font-size="10" fill="#6b7390">$0</text>

            @for (var i = 0; i < days.Count; i++)
            {
                var d = days[i];
                var x = left + i * slot + (slot - barWidth) / 2;
                var y = Y(d.CostUsd);
                var h = baseline - y;
                <g>
                    @* Hit target: the whole slot, taller than the bar, carries the tooltip. *@
                    <rect x="@((left + i * slot).ToString(inv))" y="@top" width="@slot.ToString(inv)" height="@(height - top - bottom)" fill="transparent">
                        <title>@d.Day.Date("dd MMM"): @Usd(d.CostUsd), @T.Count(d.Runs, "run", "runs")</title>
                    </rect>
                    @if (h >= 1)
                    {
                        var r = Math.Min(4, Math.Min(barWidth / 2, h));
                        @* Rounded data end, square at the baseline. *@
                        <path pointer-events="none" fill="#3b5bdb"
                              d="M@(x.ToString(inv)),@(baseline) V@((y + r).ToString(inv)) Q@(x.ToString(inv)),@(y.ToString(inv)) @((x + r).ToString(inv)),@(y.ToString(inv)) H@((x + barWidth - r).ToString(inv)) Q@((x + barWidth).ToString(inv)),@(y.ToString(inv)) @((x + barWidth).ToString(inv)),@((y + r).ToString(inv)) V@(baseline) Z" />
                    }
                    @* Every 7th day counted back from today, so the last tick never crowds another. *@
                    @if ((days.Count - 1 - i) % 7 == 0)
                    {
                        @:<text x="@((x + barWidth / 2).ToString(inv))" y="@(height - 6)" text-anchor="middle" font-size="10" fill="#6b7390">@d.Day.Date("dd MMM")</text>
                    }
                </g>
            }
            @if (peak is not null)
            {
                var pi = days.IndexOf(peak);
                var px = left + pi * slot + slot / 2;
                @:<text x="@px.ToString(inv)" y="@((Y(peak.CostUsd) - 4).ToString(inv))" text-anchor="middle" font-size="10" fill="#121a2e">@Usd(peak.CostUsd)</text>
            }
        </svg>
        <details class="mt-2 small">
            <summary class="text-muted">@T["Show as a table"]</summary>
            <table class="table table-sm mt-2 mb-0">
                <thead><tr><th>@T["Day"]</th><th class="text-end">@T["Runs"]</th><th class="text-end">@T["Cost"]</th></tr></thead>
                <tbody>
                    @foreach (var d in days.Where(d => d.Runs > 0 || d.CostUsd > 0))
                    {
                        <tr><td>@d.Day.Date("dd MMM yyyy")</td><td class="text-end">@d.Runs</td><td class="text-end">@Usd(d.CostUsd)</td></tr>
                    }
                </tbody>
            </table>
        </details>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h2 class="h6 mb-0">@T["This month by prompt (top 10)"]</h2></div>
            <div class="card-body p-0">
                @if (!Model.ByPrompt.Any())
                {
                    <p class="text-muted small p-3 mb-0">@T["No runs this month."]</p>
                }
                else
                {
                    <table class="table mb-0 pm-table">
                        <thead><tr><th>@T["Prompt"]</th><th class="text-end">@T["Runs"]</th><th class="text-end">@T["Cost"]</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.ByPrompt)
                            {
                                <tr>
                                    <td><a asp-controller="Prompts" asp-action="Details" asp-route-id="@p.PromptId">@p.Name</a></td>
                                    <td class="text-end">@p.Runs</td>
                                    <td class="text-end">@Usd(p.CostUsd)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h2 class="h6 mb-0">@T["This month by model"]</h2></div>
            <div class="card-body p-0">
                @if (!Model.ByModel.Any())
                {
                    <p class="text-muted small p-3 mb-0">@T["No calls this month."]</p>
                }
                else
                {
                    <table class="table mb-0 pm-table" data-testid="by-model">
                        <thead><tr><th>@T["Model"]</th><th class="text-end">@T["Calls"]</th><th class="text-end">@T["Cost"]</th></tr></thead>
                        <tbody>
                            @foreach (var m in Model.ByModel)
                            {
                                <tr><td><code>@m.Name</code></td><td class="text-end">@m.Runs</td><td class="text-end">@Usd(m.CostUsd)</td></tr>
                            }
                        </tbody>
                    </table>
                }
                @if (Model.FailedRunsMonthToDate > 0)
                {
                    <p class="small text-muted px-3 py-2 mb-0">@T["Failed runs this month (no cost recorded): {0}", Model.FailedRunsMonthToDate]</p>
                }
            </div>
        </div>
    </div>
</div>
