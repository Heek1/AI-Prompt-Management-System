@inject PromptManager.Services.ICurrentUser CurrentUser
@inject PromptManager.Services.ICollaborationService Collaboration
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string? Current(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
        && (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "page" : null;
    var unread = CurrentUser.IsSignedIn ? await Collaboration.UnreadCountAsync() : 0;
    var onLibrary = Current("Prompts") is not null && action != "Create" || Current("Evals") is not null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#121a2e" />
    <title>@ViewData["Title"] | Prompt Manager</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <meta name="color-scheme" content="light dark" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="preload" href="~/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable btn btn-marker position-absolute m-2" href="#main" style="z-index: 10">@T["Skip to content"]</a>
    <div class="pm-shell">
        <aside class="pm-side" data-side>
            <div class="pm-topbar">
                <a class="pm-wordmark" asp-controller="Prompts" asp-action="Index" aria-label="@T["Prompt Manager, library"]">
                    <span class="pm-braces" aria-hidden="true">{{ }}</span>promptmanager
                </a>
                <button type="button" class="pm-menu-button" data-menu-toggle aria-expanded="false" aria-controls="pm-side-body">@T["Menu"]</button>
            </div>

            <div class="pm-side-body" id="pm-side-body">
                <nav aria-label="@T["Main"]">
                    <ul class="pm-nav">
                        <li><a asp-controller="Prompts" asp-action="Index" aria-current="@(onLibrary ? "page" : null)">@T["Library"]</a></li>
                        <li><a asp-controller="Runs" asp-action="Index" aria-current="@Current("Runs")">@T["Runs"]</a></li>
                        @if (CurrentUser.IsSignedIn)
                        {
                            <li><a asp-controller="Prompts" asp-action="Create" aria-current="@Current("Prompts", "Create")">@T["New prompt"]</a></li>
                            <li><a href="/Inbox" aria-current="@Current("Collaboration")"><span>@T["Inbox"]</span>@if (unread > 0)
                                {
                                    <span class="pm-count" aria-label="@unread unread">@(unread > 99 ? "99+" : unread)</span>
                                }</a></li>
                        }
                    </ul>

                    @if (CurrentUser.IsSignedIn)
                    {
                        <div class="pm-nav-group">@T["Workspace"]</div>
                        <ul class="pm-nav">
                            <li><a asp-controller="ApiKeys" asp-action="Index" aria-current="@Current("ApiKeys")">@T["API keys"]</a></li>
                            @if (CurrentUser.IsAdmin)
                            {
                                <li><a asp-controller="Costs" asp-action="Index" aria-current="@Current("Costs")">@T["Costs"]</a></li>
                                <li><a asp-controller="Lists" asp-action="Index" aria-current="@Current("Lists")">@T["Lists"]</a></li>
                            }
                        </ul>
                    }
                </nav>

                <div class="pm-side-foot">
                    @if (CurrentUser.IsSignedIn)
                    {
                        <div class="pm-user">
                            <span>@await CurrentUser.GetDisplayNameAsync()</span>
                            @if (CurrentUser.IsAdmin)
                            {
                                <span class="pm-role">admin</span>
                            }
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-1">
                            <button type="submit" class="btn btn-link">@T["Sign out"]</button>
                        </form>
                    }
                    else
                    {
                        <div class="d-grid gap-2">
                            <a class="btn btn-marker btn-sm" asp-controller="Account" asp-action="Register">@T["Create account"]</a>
                            <a asp-controller="Account" asp-action="Login" class="text-center">@T["Sign in"]</a>
                        </div>
                    }
                    <div class="pm-theme" role="group" aria-label="@T["Theme"]">
                        <button type="button" data-theme-choice="auto" aria-pressed="true">@T["Auto"]</button>
                        <button type="button" data-theme-choice="light" aria-pressed="false">@T["Light"]</button>
                        <button type="button" data-theme-choice="dark" aria-pressed="false">@T["Dark"]</button>
                    </div>
                </div>
            </div>
        </aside>

        <main class="pm-main" id="main">
            <div class="pm-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="status">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Dismiss"]"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Dismiss"]"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
