@inject PromptManager.Services.ICurrentUser CurrentUser
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Prompt Manager</title>
    @await RenderSectionAsync("Head", required: false)
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar-brand { font-weight: 700; letter-spacing: 0.5px; }
        .badge-tool { font-size: 0.75rem; }
        .star-rating span { color: #ffc107; }
        .version-badge { font-size: 0.7rem; }
        .prompt-card { transition: box-shadow 0.2s; }
        .prompt-card:hover { box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .archived-overlay { opacity: 0.6; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Prompts" asp-action="Index">
                <i class="bi bi-lightning-charge-fill text-warning"></i> Prompt Manager
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Prompts" asp-action="Index">
                            <i class="bi bi-collection"></i> Library
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Prompts" asp-action="Create">
                            <i class="bi bi-plus-circle"></i> New Prompt
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Runs" asp-action="Index">
                            <i class="bi bi-play-circle"></i> Runs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="History" asp-action="Index">
                            <i class="bi bi-clock-history"></i> Usage History
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto me-3 align-items-lg-center">
                    @if (CurrentUser.IsSignedIn)
                    {
                        <li class="nav-item">
                            <span class="navbar-text small me-2">
                                <i class="bi bi-person-circle"></i> @await CurrentUser.GetDisplayNameAsync()
                                @if (CurrentUser.IsAdmin)
                                {
                                    <span class="badge bg-warning text-dark ms-1">admin</span>
                                }
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link">Sign out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Create account</a></li>
                    }
                </ul>
                <span class="navbar-text text-muted small">
                    <a href="/health" target="_blank" class="text-muted text-decoration-none">
                        <i class="bi bi-heart-pulse text-success"></i> Health
                    </a>
                </span>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
