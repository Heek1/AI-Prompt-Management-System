@using PromptManager.Infrastructure
@model (DiffResult Diff, string LeftLabel, string RightLabel)
@functions {
    static string RowClass(DiffLine line) => line.Kind switch
    {
        DiffLineKind.Deleted => "diff-del",
        DiffLineKind.Inserted => "diff-ins",
        DiffLineKind.Modified => "diff-mod",
        DiffLineKind.Empty => "diff-empty",
        _ => ""
    };
}
<p class="pm-diff-summary">
    @if (Model.Diff.HasChanges)
    {
        <span class="is-added">+@Model.Diff.Added added</span>
        <span class="is-removed">-@Model.Diff.Removed removed</span>
        <span class="is-changed">~@Model.Diff.Modified changed</span>
    }
    else
    {
        <span>@T["No differences."]</span>
    }
</p>
<div class="table-responsive">
    <table class="table table-sm diff-table mb-0" aria-label="Differences between @Model.LeftLabel and @Model.RightLabel">
        <colgroup>
            <col style="width: 3.5rem" /><col /><col style="width: 3.5rem" /><col />
        </colgroup>
        <thead>
            <tr>
                <th colspan="2">@Model.LeftLabel</th>
                <th colspan="2">@Model.RightLabel</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Diff.Rows)
            {
                <tr>
                    <td class="num @RowClass(row.Old)">@row.Old.Number</td>
                    <td class="@RowClass(row.Old) old">@foreach (var seg in row.Old.Segments){if (seg.Changed && row.Old.Kind == DiffLineKind.Modified){<mark>@seg.Text</mark>}else{@seg.Text}}</td>
                    <td class="num @RowClass(row.New)">@row.New.Number</td>
                    <td class="@RowClass(row.New) new">@foreach (var seg in row.New.Segments){if (seg.Changed && row.New.Kind == DiffLineKind.Modified){<mark>@seg.Text</mark>}else{@seg.Text}}</td>
                </tr>
            }
        </tbody>
    </table>
</div>
