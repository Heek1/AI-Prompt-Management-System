@{
    var statusCode = ViewData["StatusCode"] as int? ?? 500;
    var notFound = statusCode == 404;
    ViewData["Title"] = notFound ? "Not found" : "Error";
}

<section class="pm-error">
    <div class="pm-error-code" aria-hidden="true">@statusCode</div>
    @if (notFound)
    {
        <h1>@T["Nothing here"]</h1>
        <p class="pm-sub">@T["The page or prompt you are looking for does not exist."]</p>
    }
    else
    {
        <h1>@T["Something broke"]</h1>
        <p class="pm-sub">@T["Something went wrong while processing your request."]</p>
    }
    <p class="text-muted small">@T["Request ID:"] <code>@ViewData["RequestId"]</code></p>
    <a class="btn btn-primary mt-2" asp-controller="Prompts" asp-action="Index">@T["Back to the library"]</a>
</section>
