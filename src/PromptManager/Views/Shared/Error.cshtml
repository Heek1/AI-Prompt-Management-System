@{
    var statusCode = ViewData["StatusCode"] as int? ?? 500;
    var notFound = statusCode == 404;
    ViewData["Title"] = notFound ? "Not found" : "Error";
}

<div class="row justify-content-center">
    <div class="col-md-8 text-center py-5">
        <h1 class="display-5 fw-bold">@statusCode</h1>
        @if (notFound)
        {
            <p class="lead">The page or prompt you are looking for does not exist.</p>
        }
        else
        {
            <p class="lead">Something went wrong while processing your request.</p>
        }
        <p class="text-muted small">Request ID: <code>@ViewData["RequestId"]</code></p>
        <a class="btn btn-primary" asp-controller="Prompts" asp-action="Index">Back to the library</a>
    </div>
</div>
