@using AI_Prompt_Management_System.ViewModels
@model HistoryIndexViewModel
@{
    ViewData["Title"] = "Usage History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-clock-history text-secondary"></i> Usage History</h2>
    <span class="badge bg-secondary fs-6">@Model.TotalCount total uses</span>
</div>

@if (!Model.Usages.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-4"></i>
        <p class="mt-3">No usage history yet. Use a prompt to start tracking!</p>
        <a asp-controller="Prompts" asp-action="Index" class="btn btn-primary mt-2">Go to Library</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="bi bi-file-text"></i> Prompt</th>
                            <th><i class="bi bi-person"></i> User</th>
                            <th><i class="bi bi-robot"></i> AI Tool</th>
                            <th><i class="bi bi-tag"></i> Category</th>
                            <th><i class="bi bi-calendar"></i> Used At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usage in Model.Usages)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Prompts" asp-action="Details"
                                       asp-route-id="@usage.PromptId" class="text-decoration-none fw-semibold">
                                        @usage.PromptTitle
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-person-fill"></i> @usage.UserName
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success">@usage.AiTool</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary">@usage.Category</span>
                                </td>
                                <td class="text-muted small">
                                    <i class="bi bi-clock"></i> @usage.UsedAt.ToString("dd MMM yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
