@using AI_Prompt_Management_System.ViewModels
@model PromptIndexViewModel
@{
    ViewData["Title"] = "Prompt Library";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-collection-fill text-primary"></i> Prompt Library</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Prompt
    </a>
</div>

<!-- Filters -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" value="@Model.SearchQuery"
                       class="form-control form-control-sm" placeholder="Search prompts..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Category</label>
                <select name="category" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat" selected="@(Model.CategoryFilter == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">AI Tool</label>
                <select name="aiTool" class="form-select form-select-sm">
                    <option value="">All Tools</option>
                    @foreach (var tool in Model.AiTools)
                    {
                        <option value="@tool" selected="@(Model.AiToolFilter == tool)">@tool</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Sort By</label>
                <select name="sortBy" class="form-select form-select-sm">
                    <option value="rating" selected="@(Model.SortBy == "rating")">Rating</option>
                    <option value="title" selected="@(Model.SortBy == "title")">Title</option>
                    <option value="date" selected="@(Model.SortBy == "date")">Date</option>
                    <option value="version" selected="@(Model.SortBy == "version")">Version</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-search"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary flex-fill">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Results count -->
<p class="text-muted small mb-3">Showing <strong>@Model.Prompts.Count</strong> prompts</p>

@if (!Model.Prompts.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-4"></i>
        <p class="mt-3">No prompts found. <a asp-action="Create">Create the first one!</a></p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var prompt in Model.Prompts)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 prompt-card shadow-sm @(prompt.IsArchived ? "archived-overlay" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-0">
                                <a asp-action="Details" asp-route-id="@prompt.Id" class="text-decoration-none text-dark">
                                    @prompt.Title
                                </a>
                            </h6>
                            @if (prompt.IsArchived)
                            {
                                <span class="badge bg-secondary">Archived</span>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary badge-tool">@prompt.Category</span>
                            <span class="badge bg-success bg-opacity-10 text-success badge-tool">@prompt.AiTool</span>
                            <span class="badge bg-light text-dark border version-badge">v@(prompt.CurrentVersion)</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted"><i class="bi bi-person"></i> @prompt.Author</small>
                            <div class="star-rating">
                                <span>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= Math.Round(prompt.AverageRating) ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </span>
                                <small class="text-muted">@prompt.AverageRating.ToString("F1")</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@prompt.Id" class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-eye"></i> View
                        </a>
                        @if (!prompt.IsArchived)
                        {
                            <form asp-action="Archive" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@prompt.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        onclick="return confirm('Archive this prompt?')">
                                    <i class="bi bi-archive"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
